if not game:IsLoaded() then
    game.Loaded:Wait()
end

local currentPlaceId = game.PlaceId

local placeLoaders = {
    [127794225497302] = {
        name = "Abyss",
        execute = function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ChickenAbii/ChickenHub/refs/heads/main/Abyss"))()
        end,
    },
    [136801880565837] = {
        name = "Flick",
        execute = function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ChickenAbii/ChickenHub/refs/heads/main/Flick"))()
        end,
    },
    [130594398886540] = {
        name = "GardenHorizons",
        execute = function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ChickenAbii/ChickenHub/refs/heads/main/GardenHorizons"))()
        end,
    },
}

local loader = placeLoaders[currentPlaceId]

if loader then
    local ok, err = pcall(loader.execute)
    if not ok then
        warn("[CH Main Loader] Failed to execute loader for " .. (loader.name or "Unknown") .. ": " .. tostring(err))
    end
else
    print("=============================")
    print("== your game is currently unsupported")
    print("== placeId: " .. tostring(currentPlaceId))
    print("=============================")
end
